# HTTP
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/dbproyecto-iot

# Autenticación
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES

# MQTT. MQTT_BROKER_* es la forma usada por el registro de dispositivos.
# MQTT_HOST/MQTT_PORT son alias opcionales; si faltan se usan los anteriores.
MQTT_TLS=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_LISTENER_USER=backend_listener
MQTT_LISTENER_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_DEL_USUARIO_MQTT
MQTT_CA_FILE=../mqtt-broker-local/config/certs/ca.crt

# Administración local de Mosquitto
MOSQUITTO_CONTAINER_NAME=mqtt-broker-local
MQTT_PASSWD_FILE=../mqtt-broker-local/config/passwd
MQTT_ACL_FILE=../mqtt-broker-local/config/acl.conf
