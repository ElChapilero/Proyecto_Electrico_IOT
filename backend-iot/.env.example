# Configuración HTTP
PORT=3000 # puerto del servidor
CORS_ORIGINS=http://localhost:5173 # origen permitido para conexiones
DB_STATEMENT_TIMEOUT_MS=5000 # tiempo máximo de ejecución de consultas

# PostgreSQL
DATABASE_URL=postgres://USUARIO:CONTRASENA@localhost:5432/dbproyecto-iot

# Autenticación # clave para firmar tokens JWT
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES

# Configuración MQTT
MQTT_TLS=true # activar conexión MQTT cifrada
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=8883
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_LISTENER_USER=backend_listener
MQTT_LISTENER_PASSWORD=REEMPLAZAR_CON_LA_CLAVE_DEL_USUARIO_MQTT
MQTT_CA_FILE=../mqtt-broker-local/config/certs/ca.crt # certificado para verificar el servidor MQTT

# Administración local de Mosquitto
MOSQUITTO_CONTAINER_NAME=mqtt-broker-local
MQTT_PASSWD_FILE=../mqtt-broker-local/config/passwd
MQTT_ACL_FILE=../mqtt-broker-local/config/acl.conf
